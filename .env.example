DATABASE_URL=postgresql+asyncpg://aaa:aaa@localhost:5434/aaa
# JWT_SECRET must be at least 32 characters.
JWT_SECRET=change-me-to-a-secret-at-least-32-chars
# Comma-separated Gemini keys. Each key is one worker in the pool.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_VISION_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_VISION_TIMEOUT_SECONDS=360
GEMINI_MAX_TOKENS=2048
GEMINI_VISION_MAX_TOKENS=512
GEMINI_COOLING_SECONDS=60
GEMINI_TUTOR_TEMPERATURE=0.8
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RAG_TOP_K=5
VISION_MAX_PDF_PAGES=0
VISION_MAX_IMAGE_EDGE=768
TTS_ENGLISH_RATE=-5%
